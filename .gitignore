# No trailing slash: an agent worktree gets `node_modules` as a SYMLINK to the
# main checkout, and `node_modules/` only matches directories, so the link showed
# up as untracked in every status and `git add -A` would have committed it.
node_modules
main.js
*.map
.DS_Store
.idea/
.vscode/
coverage/
.release/
.beta-artifact/
# R1a: the probe entries of `scripts/tests/probar-build-host-esm.mjs`.
.host-esm/
# The Hebra plugin files, GENERATED by `npm run build:host-esm` and `npm run release:package`.
# Anchored to the root: an unanchored `hebra-styles.css` would also hide a source of that name
# (jdex-manager's CI broke that way).
/hebra-main.mjs
/hebra-styles.css
/hebra.json
/native/mumble-helper/target/
/native/mumble-helper/UNSIGNED-NOT-FOR-RELEASE.txt
.env
.env.*
*.pem
*.key
.eslintcache
/.claude/
