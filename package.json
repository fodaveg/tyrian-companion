{
	"name": "tyrian-companion",
	"version": "0.1.3",
	"private": true,
	"description": "An Obsidian desktop companion for Guild Wars 2 account context and planning.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "vitest run --configLoader runner && npm run test:h8-crossover-spike && npm run test:release-preflight && npm run test:security-scan && npm run test:release-package && npm run test:release-identity-contract && npm run test:beta-channel && npm run test:support-contract && npm run test:h8-helper-decision-contract",
		"test:h8-crossover-spike": "bash scripts/tests/probar-h8-crossover-spike.sh",
		"bench:h6-performance": "node --expose-gc node_modules/jiti/lib/jiti-cli.mjs scripts/benchmark-h6-performance.ts",
		"test:bench:h6-performance-red": "node node_modules/jiti/lib/jiti-cli.mjs scripts/test-h6-performance-red.ts",
		"test:release-preflight": "bash scripts/tests/probar-release-preflight.sh",
		"test:security-scan": "node scripts/tests/probar-security-scan.mjs",
		"test:release-package": "node scripts/tests/probar-release-package.mjs",
		"test:release-identity-contract": "node scripts/tests/probar-release-identity-contract.mjs",
		"test:beta-channel": "node scripts/tests/probar-beta-channel.mjs",
		"test:support-contract": "node scripts/tests/probar-support-contract.mjs",
		"test:h8-helper-decision-contract": "node scripts/tests/probar-h8-helper-decision-contract.mjs",
		"security:scan": "node scripts/security-scan.mjs",
		"h8:helper-decision-contract": "node scripts/h8-native-decision-contract.mjs",
		"check": "npm run lint && npm run test && npm run security:scan && npm run build",
		"release:preflight": "node scripts/release-preflight.mjs",
		"release:identity-contract": "node scripts/release-identity-contract.mjs",
		"release:package": "npm run release:identity-contract && node scripts/release-package.mjs",
		"beta:artifact": "node scripts/prepare-beta-artifact.mjs",
		"beta:install": "node scripts/install-beta.mjs install",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"guild-wars-2"
	],
	"author": "David",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/fodaveg/tyrian-companion.git"
	},
	"engines": {
		"node": "^22.20.0 || >=24.12.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^3.2.4",
		"yaml": "^2.9.0"
	}
}
