{
	"name": "tyrian-companion",
	"version": "0.1.0",
	"description": "An Obsidian desktop companion for Guild Wars 2 account context and planning.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "vitest run && npm run test:release-preflight && npm run test:security-scan && npm run test:release-package",
		"bench:h6-performance": "node --expose-gc node_modules/jiti/lib/jiti-cli.mjs scripts/benchmark-h6-performance.ts",
		"test:bench:h6-performance-red": "node node_modules/jiti/lib/jiti-cli.mjs scripts/test-h6-performance-red.ts",
		"test:release-preflight": "bash scripts/tests/probar-release-preflight.sh",
		"test:security-scan": "node scripts/tests/probar-security-scan.mjs",
		"test:release-package": "node scripts/tests/probar-release-package.mjs",
		"security:scan": "node scripts/security-scan.mjs",
		"check": "npm run lint && npm run test && npm run security:scan && npm run build",
		"release:preflight": "node scripts/release-preflight.mjs",
		"release:package": "node scripts/release-package.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"guild-wars-2"
	],
	"author": "David",
	"license": "MIT",
	"engines": {
		"node": "^22.20.0 || >=24.12.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^3.2.4",
		"yaml": "^2.9.0"
	}
}
